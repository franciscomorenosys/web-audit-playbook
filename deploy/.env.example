# =============================================================================
# Web Audit Playbook — variables de entorno del stack de la VPS
# =============================================================================
#
# CÓMO USAR ESTE FICHERO
# ----------------------
#   cp deploy/.env.example deploy/.env
#   $EDITOR deploy/.env
#
# El fichero `.env` NUNCA se versiona: el `.gitignore` del repo excluye
# `.env`, `.env.*`, `**/.env` y `**/.env.*`. Este `.env.example` es la única
# forma de documentar las variables, y por eso **todos los valores de ejemplo
# son de fábrica**: los secretos son `CAMBIAR_ESTE_VALOR`.
#
# REGLAS
# ------
#   1. Este fichero NO contiene ningún secreto real. Si algún día lo contiene,
#      es un incidente: revócalo y rota la clave.
#   2. Todo lo que esté en `CAMBIAR_ESTE_VALOR` hay que cambiarlo en el
#      primer arranque, en este orden:
#        CONSOLE_TOKEN → WEBUI_SECRET_KEY (si usas el perfil `ui`)
#   3. Las imágenes se fijan por TAG o, mejor, por DIGEST. Un `latest` es una
#      licencia que cambia sin avisar (research/06 §7.4, regla 2).
#   4. Permisos del fichero tras editarlo:  chmod 600 deploy/.env
#
# -----------------------------------------------------------------------------

# =============================================================================
# 1. IMÁGENES — fijar por digest
# =============================================================================
# Cómo resolver el digest:
#   docker buildx imagetools inspect ollama/ollama:<tag>
# o
#   docker inspect --format='{{index .RepoDigests 0}}' ollama/ollama:<tag>
#
# OLLAMA_IMAGE=ollama/ollama@sha256:CAMBIAR_ESTE_VALOR
OLLAMA_IMAGE=ollama/ollama:PIN-DIGEST-AQUI

# La consola vive en `console/` dentro del repo y el compose la construye
# (bloque `build:`). CONSOLE_IMAGE es el nombre de la imagen resultante.
# CONSOLE_IMAGE=web-audit-playbook/console@sha256:CAMBIAR_ESTE_VALOR
CONSOLE_IMAGE=web-audit-playbook/console:local

# Contexto de build de la consola (relativo a deploy/ o absoluto).
#
# OJO: es la RAÍZ del repositorio, NO `console/`. La imagen necesita
# `console/` Y `01-tooling/scripts/` (el toolchain que la consola invoca para
# el score y para la demo). El `.dockerignore` de la raíz es una lista blanca:
# al daemon de Docker sólo viajan esas rutas, así que `03-casos/` (evidencia
# de clientes reales) nunca entra en el contexto de build.
CONSOLE_CONTEXT=..

# Open WebUI (perfil `ui`). Licencia "Open WebUI License" (BSD-3 + cláusula
# anti-branding): uso interno del auditor, nunca reempaquetado ni revendido.
# OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:CAMBIAR_ESTE_VALOR
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:PIN-DIGEST-AQUI

# Imagen base del contenedor de operación sobre el volumen SQLite.
DB_IMAGE=alpine:3.20

# =============================================================================
# 2. SECRETOS — cambiar antes del primer arranque
# =============================================================================
# Token de la consola. Es local: no es una cuenta en ningún servicio externo.
# Generar con:  openssl rand -base64 48
#
# ATENCIÓN: la versión actual de la consola todavía NO implementa
# autenticación propia. El control real es que el puerto sólo se publica en
# 127.0.0.1 (acceso por túnel SSH o VPN). Este token queda preparado para la
# versión con sesión (v0.2).
CONSOLE_TOKEN=CAMBIAR_ESTE_VALOR

# Clave de sesión de Open WebUI (sólo si usas el perfil `ui`).
# Generar con:  openssl rand -base64 48
WEBUI_SECRET_KEY=CAMBIAR_ESTE_VALOR

# =============================================================================
# 3. PUERTOS — todos enlazados a 127.0.0.1
# =============================================================================
# Ningún puerto de administración se publica en 0.0.0.0. El acceso es por
# túnel SSH (ssh -L) o VPN. Ver deploy/hardening.md §2.
CONSOLE_PORT=8787
OPENWEBUI_PORT=3000

# =============================================================================
# 4. RUNTIME DE LLM
# =============================================================================
# Modelo por defecto de la VPS. Fuente: research/06 §2.2-2.3 (verificado
# 2026-11-22). El blob ocupa ~6,6-7,6 GB: la VPS necesita 8 GB de RAM.
LLM_MODEL=qwen3.5:9b

# Contexto acotado. 8 000 tokens es el máximo razonable en 8 GB: el KV cache
# solo lo revienta (research/06 §2.3, criterio 4).
OLLAMA_CONTEXT_LENGTH=8192

# q8_0 = ~1/2 de la RAM del KV cache, sin pérdida apreciable.
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# Nunca más de 2 modelos residentes: la RAM es el cuello de botella.
OLLAMA_MAX_LOADED_MODELS=2

# Una petición a la vez. Subirlo multiplica la latencia y el OOM.
OLLAMA_NUM_PARALLEL=1

# Descarga el modelo tras 5 min de inactividad.
OLLAMA_KEEP_ALIVE=5m

# Orígenes permitidos por CORS en la API de Ollama.
OLLAMA_ORIGINS=http://127.0.0.1:8787

# =============================================================================
# 5. GPU (opcional)
# =============================================================================
# none = sin GPU (VPS CPU, por defecto) · all = todas las GPUs del host ·
# 0,1 = GPUs concretas. Requiere el NVIDIA Container Toolkit en el host.
NVIDIA_VISIBLE_DEVICES=none
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Capas del modelo que se descargan a la GPU. 0 = todo en CPU.
OLLAMA_NUM_GPU=0

# =============================================================================
# 6. LÍMITES DE RECURSOS
# =============================================================================
# El límite de memoria es lo que impide que un pico de RAM tumbe el host.
# research/06 §9 (riesgo «Agotamiento de RAM (OOM)»).
OLLAMA_MEM_LIMIT=6g
CONSOLE_MEM_LIMIT=1g
OPENWEBUI_MEM_LIMIT=2g
DB_MEM_LIMIT=256m

# =============================================================================
# 7. EVIDENCIA
# =============================================================================
# Directorio del HOST donde vive la evidencia, montado en SOLO LECTURA en
# /evidencia. Relativo al directorio del proyecto (deploy/) o absoluto.
#
# La estructura esperada dentro es:
#   <EVIDENCE_HOST_DIR>/<cliente>/evidencia/              ← cruda, la ve el LLM NUNCA
#   <EVIDENCE_HOST_DIR>/<cliente>/evidencia-sanitizada/    ← saneada, la que se usa
#
# En el repo, la convención es 03-casos/<cliente>/ (excluido del .gitignore
# porque contiene material confidencial de un cliente real).
EVIDENCE_HOST_DIR=../03-casos

# Subcarpeta que la consola lee. Todo lo demás es fuera de su alcance.
EVIDENCE_SANITIZED_SUBDIR=evidencia-sanitizada

# =============================================================================
# 8. POLÍTICA DEL LLM
# =============================================================================
# revalidate = toda salida del modelo se vuelve a pasar por pii_redact.py antes
# de escribirse en un informe. Es un filtro, no una barrera: el auditor lee
# siempre. Ver PLAN-MAESTRO.md §5.
LLM_OUTPUT_POLICY=revalidate

# Tiempo máximo de una inferencia, en segundos.
LLM_TIMEOUT_S=180

# =============================================================================
# 9. VARIABLES GENERALES
# =============================================================================
TZ=America/Mexico_City

# Prefijo de los volúmenes y de la red de Docker. Útil para levantar dos
# entornos en la misma máquina (p. ej. cliente A y cliente B).
VOLUME_PREFIX=wap

# Interfaz Open WebUI: si es "true", hace falta crear el primer usuario al
# abrirla por el túnel.
OPENWEBUI_AUTH=True

# =============================================================================
# FIN DEL FICHERO
# =============================================================================
